includes:
  - vendor/jangregor/phpstan-prophecy/extension.neon

parameters:
  ignoreErrors:
    # PHP accepts void/null as handled; only strict false delegates to its native handler.
    - message: '/^Parameter \#1 \$(?:callback|error_handler) of function set_error_handler expects/'
      identifier: argument.type
      path: src/ErrorHandler.php
      count: 1
