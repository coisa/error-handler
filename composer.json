{
    "name": "coisa/error-handler",
    "description": "Error Handler Library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentordosnerds.com.br"
        }
    ],
    "config": {
        "sort-packages": true,
        "prefer-stable": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "llm/skills": true
        }
    },
    "require": {
        "php": "^8.3",
        "container-interop/service-provider": "^0.4",
        "fast-forward/container": "^1.10",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "conflict": {
        "filp/whoops": "<2.18.7"
    },
    "autoload": {
        "psr-4": {
            "CoiSA\\ErrorHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "/tests/Fixtures/compile-fatal.inc"
        ],
        "psr-4": {
            "CoiSA\\ErrorHandler\\Test\\": "tests/",
            "CoiSA\\ErrorHandler\\Example\\": "resources/skills/coisa-error-handler/examples/"
        }
    },
    "require-dev": {
        "coisa/php-cs-fixer": "^3.0",
        "filp/whoops": "^2.18.7",
        "jangregor/phpstan-prophecy": "^2.3",
        "llm/skills": "^1.15",
        "nyholm/psr7": "^1.8.2",
        "nyholm/psr7-server": "^1.1",
        "phly/phly-event-dispatcher": "^1.6",
        "phpspec/prophecy": "^1.26",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.4",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/process": "^7.4 || ^8.1"
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@sniff",
            "@test",
            "@analyze"
        ],
        "analyze": "phpstan analyze --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs-fix": [
            "php-cs-fixer fix",
            "phpcbf"
        ],
        "sniff": "phpcs",
        "test": "phpunit --no-coverage --colors=always",
        "test-coverage": "phpunit --colors=always"
    },
    "extra": {
        "skills": {
            "source": "resources/skills"
        }
    },
    "suggest": {
        "llm/skills": "Optionally synchronize the bundled agent skill in consumer projects.",
        "filp/whoops": "Install ^2.18.7 for optional development HTML responses."
    }
}
