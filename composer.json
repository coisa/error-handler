{
    "name": "coisa/error-handler",
    "description": "Error Handler Library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentordosnerds.com.br"
        }
    ],
    "config": {
        "sort-packages": true,
        "prefer-stable": true,
        "optimize-autoloader": true
    },
    "extra": {
        "laminas": {
            "config-provider": "CoiSA\\ErrorHandler\\Container\\ConfigProvider"
        }
    },
    "require": {
        "php": "^8.3",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "CoiSA\\ErrorHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "exclude-from-classmap": ["tests/Fire/", "tests/Http/"],
        "psr-4": {
            "CoiSA\\ErrorHandler\\Test\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "laminas/laminas-servicemanager": "^4.3",
        "nyholm/psr7": "^1.8",
        "phly/phly-event-dispatcher": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@sniff",
            "@test",
            "@analyze",
            "@fire-test",
            "@http-test"
        ],
        "analyze": "phpstan analyze --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": [
            "php-cs-fixer fix",
            "phpcbf"
        ],
        "sniff": "phpcs",
        "test": "phpunit",
        "fire-test": "@php tests/Fire/run.php",
        "http-test": "@php tests/Http/run.php"
    }
}
