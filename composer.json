{
    "name": "coisa/error-handler",
    "description": "Error Handler Library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentordosnerds.com.br"
        }
    ],
    "config": {
        "sort-packages": true,
        "prefer-stable": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "llm/skills": true,
            "ocramius/package-versions": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "CoiSA\\ErrorHandler\\Container\\ConfigProvider"
        },
        "skills": {
            "source": "resources/skills"
        }
    },
    "suggest": {
        "ext-json": "Required only for debug JSON responses on PHP 7.4; included in PHP 8.",
        "fast-forward/container": "^1.9",
        "filp/whoops": "Install ^2.18.7 for optional development HTML responses.",
        "llm/skills": "Optionally synchronize the bundled agent skill in consumer projects."
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "container-interop/service-provider": "^0.4",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "conflict": {
        "filp/whoops": "<2.18.7"
    },
    "autoload": {
        "psr-4": {
            "CoiSA\\ErrorHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoiSA\\ErrorHandler\\Test\\": "tests/",
            "CoiSA\\ErrorHandler\\Example\\": "resources/skills/coisa-error-handler/examples/"
        },
        "exclude-from-classmap": [
            "/tests/Fixtures/compile-fatal.inc"
        ]
    },
    "require-dev": {
        "coisa/php-cs-fixer": "^3.0",
        "fast-forward/container": "^1.9",
        "filp/whoops": "^2.18.7",
        "jangregor/phpstan-prophecy": "^1.0",
        "laminas/laminas-servicemanager": "^4.3",
        "llm/skills": "^1.15",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phly/phly-event-dispatcher": "^1.0",
        "phpspec/prophecy": "^1.20",
        "phpspec/prophecy-phpunit": "^2.1",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0",
        "symfony/process": "^5.4 || ^6.4 || ^7.4 || ^8.0"
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@sniff",
            "@test",
            "@analyze"
        ],
        "analyze": "phpstan analyze --level max ./src ./tests",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": [
            "php-cs-fixer fix",
            "phpcbf"
        ],
        "sniff": "phpcs",
        "test": "phpunit --no-coverage --colors=always",
        "test-coverage": "phpunit --colors=always"
    }
}
